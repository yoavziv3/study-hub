#!/bin/zsh
# On every push of main: deploy that exact commit to Cloudflare Pages in the background.
ROOT="$(git rev-parse --show-toplevel)"
mkdir -p "$ROOT/logs"
while read local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" && "$local_sha" != 0000000000000000000000000000000000000000 ]]; then
    PATH="/opt/homebrew/bin:$PATH" nohup "$ROOT/scripts/deploy-cloud.sh" "$local_sha" >> "$ROOT/logs/deploy.log" 2>&1 &
    echo "☁️  Cloudflare deploy started in the background (logs/deploy.log)"
  fi
done
exit 0

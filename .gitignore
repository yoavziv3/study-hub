node_modules
dist
dist-cloud
logs
# Model answers cached by request (server/lib/ai-cache.js)
cache/
.env

# Private / machine-local state – never commit
data/moodle.json
data/progress.json
data/*.tmp

# Lecture data IS committed (the cloud site is built from it), except the intermediate PDFs.
# The cloud shows slides from one PDF per lecture (deck.pdf, or the original if it's a PDF), so the rendered
# slide images stay on this Mac – only the first-slide thumbnail is committed.
data/lectures/*/slides.pdf
data/lectures/*/slides/*
!data/lectures/*/slides/t001.jpg
data/lectures/**/*.tmp
# Lesson transcripts of exam-prep units stay on this Mac (used only to write the study material).
data/lectures/*/transcript.txt

inbox/*
!inbox/.gitkeep
.DS_Store

# Cloudflare local dev (wrangler pages dev): local database and dev secrets
.wrangler/
.dev.vars

# Before/after screenshots for design reviews
.design-shots/
data/reports.json

# Weekly backups of student accounts from the cloud – never commit
backups/
.playwright-mcp/

# The Mac's key for students' sealed portal sign-ins, and its portal sessions – never commit
portal-key.json
portal-sessions.json
quarantine/

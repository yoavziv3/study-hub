# AI: by default the site uses your local Claude Code login (no key needed).
# To use the Anthropic API instead, set a key:
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=api        # or: cli
# AI_MODEL=claude-opus-5-5

# Or Gemini from Google AI Studio (key: https://aistudio.google.com/apikey). Its free tier has small daily limits
# per project – see them in AI Studio and set GEMINI_RPM / GEMINI_RPD to match. On the free tier Google may use
# what is sent to improve its products.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   # a free-tier model (Pro models are paid only)
# GEMINI_RPM=5                    # requests per minute
# GEMINI_RPD=100                  # requests per day (resets at midnight Pacific time)
# GEMINI_RESERVE=0.4              # share of the day kept for new lessons (question banks stop before it)

# New notices (Moodle announcements, portal notices) are read by Claude whatever AI_PROVIDER is (server/lib/notices.js),
# through ANTHROPIC_API_KEY or the logged-in claude CLI. A light model is enough; NOTICES=0 turns it off.
# NOTICES_MODEL=claude-sonnet-5-5
# PORT=5180

# Cloud site where students sign in with Moodle. The Mac reads other students' courses through its admin
# channel; the same secret is set in Cloudflare as ADMIN_SECRET (wrangler pages secret put ADMIN_SECRET).
CLOUD_URL=https://study-hub-git.pages.dev
STUDY_ADMIN_SECRET=
